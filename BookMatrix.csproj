<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BookMatrix</RootNamespace>
    <UserSecretsId>bookmatrix-admin-secrets-1f91e672-515d-4571-96d2-0838f932d51c</UserSecretsId>
