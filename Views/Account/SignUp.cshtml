@model SignUpInputModel
@{
    ViewData["TitleKey"] = "signupTitle";
    ViewData["Page"] = "signup";
}

  <div class="view" id="signup">
    <main class="auth">
      <h1 data-i18n="signupHeading">@L["signupHeading"]</h1>
      <p class="subtitle" data-i18n="signupIntro">@L["signupIntro"]</p>

      <form asp-controller="Account" asp-action="SignUp" method="post" id="signup-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl">
        <div asp-validation-summary="All" class="error"></div>
        @if (ViewData["AuthError"] is string authError)
        {
          <p class="error">@authError</p>
        }
        <div class="field">
          <label for="name" data-i18n="displayName">@L["displayName"]</label>
          <input id="name" name="FullName" type="text" value="@Model.FullName" maxlength="100" autocomplete="name" required>
          <p class="error" id="name-error"></p>
        </div>

        <div class="field">
          <label for="email" data-i18n="email">@L["email"]</label>
          <input id="email" name="Email" type="email" value="@Model.Email" maxlength="254" autocomplete="email" required>
          <p class="error" id="email-error"></p>
        </div>

        <div class="field">
          <label for="password" data-i18n="password">@L["password"]</label>
          <input id="password" name="Password" type="password" autocomplete="new-password" required>
          <p class="hint" data-i18n="passwordHint">@L["passwordHint"]</p>
          <p class="error" id="password-error"></p>
        </div>

        <div class="field">
          <label for="confirm" data-i18n="confirmPassword">@L["confirmPassword"]</label>
          <input id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" required>
          <p class="error" id="confirm-error"></p>
        </div>

        <button type="submit" class="submit" data-i18n="createAccount">@L["createAccount"]</button>
      </form>

      <p class="alt"><span data-i18n="alreadyAccount">@L["alreadyAccount"]</span> <a asp-controller="Account" asp-action="Login" data-i18n="loginLink">@L["loginLink"]</a></p>
      <a asp-controller="Home" asp-action="Index" class="back" data-nav="home" data-i18n="backToSite">@L["backToSite"]</a>
    </main>
  </div>

@section Scripts {
  <script src="~/js/auth.js" asp-append-version="true"></script>
}
