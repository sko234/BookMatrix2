@{
    var titleKey = ViewData["TitleKey"] as string ?? "homeTitle";
    var pageName = ViewData["Page"] as string ?? "home";
}
<!DOCTYPE html>
<html lang="@L.Language">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@L[titleKey]</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body data-page="@pageName" data-title-key="@titleKey">

  <!-- Shared header (home, sign up, log in) -->
  <header class="site-header">
    <a asp-controller="Home" asp-action="Index" asp-fragment="catalog" class="btn btn-light" data-nav="catalog" data-i18n="catalog">@L["catalog"]</a>
    <a asp-controller="Home" asp-action="Index" class="brand" data-nav="home"><img src="~/assets/bookmatrix-logo.png" alt="BookMatrix" style="display: block; width: 100%; height: 100%; object-fit: contain;"></a>
    <div class="header-actions">
      <button type="button" class="btn btn-light language-toggle" id="language-toggle" aria-label="@L[L.Language == "en" ? "switchToBulgarian" : "switchToEnglish"]">@(L.Language == "en" ? "БГ" : "EN")</button>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <form asp-controller="Account" asp-action="Logout" method="post">
          <button type="submit" class="btn btn-light" data-i18n="logout">@L["logout"]</button>
        </form>
      }
      else
      {
        <a asp-controller="Account" asp-action="Login" class="btn btn-light" data-i18n="headerLogin">@L["headerLogin"]</a>
        <a asp-controller="Account" asp-action="SignUp" class="btn btn-light" data-nav="signup" data-i18n="headerSignUp">@L["headerSignUp"]</a>
      }
    </div>
  </header>

  @RenderBody()

  <footer class="site-footer">
    <div class="footer-brand">BookMatrix</div>
    <p data-i18n="creators">@L["creators"]</p>
    <p data-i18n="copyright">@L["copyright"]</p>
  </footer>

  <script>
    window.BM = {
      language: @Json.Serialize(L.Language),
      translations: @Json.Serialize(Translations.All)
    };
  </script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
